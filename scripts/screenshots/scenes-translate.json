{
  "baseUrls": {
    "demo": "https://companygpt.innfactory.ai"
  },
  "defaults": {
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "deviceScaleFactor": 1,
    "colorScheme": "light",
    "public": false
  },
  "scenes": [
    {
      "id": "translate-text-sprachen",
      "lang": "de",
      "baseUrl": "demo",
      "path": "/companygpt/translate/de/text",
      "waitFor": "main button:has-text(\"Sprache erkennen\")",
      "settleMs": 1000,
      "output": "src/content/docs/de/company-gpt/addons/company-translate/text-sprachen.png"
    },
    {
      "id": "translate-text-sprachen",
      "lang": "en",
      "baseUrl": "demo",
      "path": "/companygpt/translate/en/text",
      "waitFor": "main button:has-text(\"Detect language\")",
      "settleMs": 1000,
      "output": "src/content/docs/en/company-gpt/addons/company-translate/text-sprachen.png"
    },
    {
      "id": "translate-text-uebersetzung",
      "lang": "de",
      "baseUrl": "demo",
      "path": "/companygpt/translate/de/text",
      "waitFor": "main button:has-text(\"Sprache erkennen\")",
      "actions": [
        {
          "action": "click",
          "selector": "main button[aria-haspopup=dialog]:has-text(\"Mehr\") >> nth=1"
        },
        {
          "action": "fill",
          "selector": "[role=dialog] input[role=combobox]",
          "value": "Dänisch"
        },
        {
          "action": "click",
          "selector": "[role=dialog] [role=option]:has-text(\"Dänisch\")"
        },
        {
          "action": "fill",
          "selector": "main textarea",
          "value": "Willkommen bei der Muster GmbH. Wir freuen uns auf die Zusammenarbeit mit Ihnen."
        },
        {
          "action": "wait",
          "selector": "main button:has-text(\"Erkannt: Deutsch\")"
        },
        {
          "action": "wait",
          "selector": "main >> text=Velkommen"
        }
      ],
      "settleMs": 1000,
      "selector": "main .bg-surface-card",
      "padding": 16,
      "output": "src/content/docs/de/company-gpt/addons/company-translate/text-uebersetzung.png"
    },
    {
      "id": "translate-text-uebersetzung",
      "lang": "en",
      "baseUrl": "demo",
      "path": "/companygpt/translate/en/text",
      "waitFor": "main button:has-text(\"Detect language\")",
      "actions": [
        {
          "action": "click",
          "selector": "main button[aria-haspopup=dialog]:has-text(\"More\") >> nth=1"
        },
        {
          "action": "fill",
          "selector": "[role=dialog] input[role=combobox]",
          "value": "Danish"
        },
        {
          "action": "click",
          "selector": "[role=dialog] [role=option]:has-text(\"Danish\")"
        },
        {
          "action": "fill",
          "selector": "main textarea",
          "value": "Willkommen bei der Muster GmbH. Wir freuen uns auf die Zusammenarbeit mit Ihnen."
        },
        {
          "action": "wait",
          "selector": "main button:has-text(\"Detected: German\")"
        },
        {
          "action": "wait",
          "selector": "main >> text=Velkommen"
