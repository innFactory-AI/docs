{
  "baseUrls": {
    "demo": "https://companygpt.innfactory.ai"
  },
  "defaults": {
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "deviceScaleFactor": 1,
    "colorScheme": "light",
    "public": false
  },
  "scenes": [
    {
      "id": "agent-tool-library",
      "lang": "de",
      "note": "Agent-Builder (neuer Agent, nichts gespeichert), Tool-Bibliothek mit Filter Nativ.",
      "baseUrl": "demo",
      "path": "/c/new",
      "waitFor": "role=button[name=\"Agenten erstellen\"]",
      "actions": [
        {
          "action": "click",
          "selector": "role=button[name=\"Agenten erstellen\"]"
        },
        {
          "action": "wait",
          "selector": "role=combobox[name=\"Agent\"]"
        },
        {
          "action": "click",
          "selector": "role=button[name=\"Tools hinzufügen\"]"
        },
        {
          "action": "wait",
          "selector": "role=dialog[name=\"Tool-Bibliothek\"]"
        },
        {
          "action": "click",
          "selector": "role=dialog >> role=button[name=/^Nativ \\d/]"
        },
        {
          "action": "wait",
          "ms": 800
        }
      ],
      "clip": {
        "x": 120,
        "y": 54,
        "width": 1200,
        "height": 372
      },
      "settleMs": 800,
      "output": "src/content/docs/de/company-gpt/agent-tool-library.png"
    },
    {
      "id": "agent-action-new",
      "lang": "de",
      "note": "Demo-Agent „Muster-Assistent“ (Testkonto). Dialog für eine neue Aktion mit erfundenem Beispielschema, nicht gespeichert.",
      "baseUrl": "demo",
      "path": "/c/new",
      "waitFor": "role=button[name=\"Agenten erstellen\"]",
      "actions": [
        {
          "action": "click",
          "selector": "role=button[name=\"Agenten erstellen\"]"
        },
        {
          "action": "wait",
          "selector": "role=combobox[name=\"Agent\"]"
        },
        {
          "action": "click",
          "selector": "role=combobox[name=\"Agent\"]"
        },
        {
          "action": "click",
          "selector": "role=option[name=\"Muster-Assistent\"]"
        },
        {
          "action": "wait",
          "selector": "role=button[name=\"Muster-Assistent teilen\"]"
        },
        {
          "action": "click",
          "selector": "role=button[name=\"Tools hinzufügen\"]"
        },
        {
          "action": "click",
          "selector": "role=dialog >> role=button[name=\"Neu erstellen …\"]"
        },
        {
          "action": "click",
          "selector": "role=menuitem[name=\"Aktionen\"]"
        },
        {
          "action": "wait",
          "selector": "role=dialog[name=\"Neue Aktion\"]"
        },
        {
          "action": "fill",
          "selector": "role=dialog[name=\"Neue Aktion\"] >> role=textbox[name=\"Schema\"]",
          "value": "{\n  \"openapi\": \"3.1.0\",\n  \"info\": {\n    \"title\": \"Muster-API\",\n    \"version\": \"1.0.0\"\n  },\n  \"servers\": [\n    {\n      \"url\": \"https://api.example.com\"\n    }\n  ],\n  \"paths\": {\n    \"/termine\": {\n      \"get\": {\n        \"operationId\": \"listeTermine\",\n        \"summary\": \"Termine der Muster GmbH abrufen\",\n        \"responses\": {\n          \"200\": {\n            \"description\": \"OK\"\n          }\n        }\n      }\n    }\n  }\n}"
        },
        {
          "action": "wait",
          "selector": "role=dialog[name=\"Neue Aktion\"] >> role=table"
        },
        {
          "action": "press",
          "selector": "role=dialog[name=\"Neue Aktion\"] >> role=textbox[name=\"Schema\"]",
          "key": "Control+Home"
        },
        {
          "action": "hover",
          "selector": "role=dialog[name=\"Neue Aktion\"] >> role=heading"
        }
      ],
      "selector": "role=dialog[name=\"Neue Aktion\"]",
      "padding": 16,
      "output": "src/content/docs/de/company-gpt/actions-open-api.png"
    },
