  "scenes": [
    {
      "id": "prompts",
      "lang": "de",
      "note": "Seitenleiste Prompts, nach Namen gefiltert. Braucht die eigenen Demo-Prompts „Besprechungsprotokoll“ (DE) und „Meeting minutes“ (EN).",
      "baseUrl": "demo",
      "path": "/c/new",
      "waitFor": "role=button[name=\"Attach and tools\"]",
      "actions": [
        {
          "action": "click",
          "selector": "role=button[name=\"Prompts\"]"
        },
        {
          "action": "wait",
          "selector": "role=region >> role=button[name^=\"Besprechungsprotokoll\"]"
        },
        {
          "action": "fill",
          "selector": "role=textbox[name=\"Prompts nach Namen filtern\"]",
          "value": "Protokoll"
        },
        {
          "action": "wait",
          "ms": 1200
        },
        {
          "action": "hover",
          "selector": "role=complementary >> role=heading[name=\"Prompts\"]"
        }
      ],
      "clip": {
        "x": 52,
        "y": 0,
        "width": 308,
        "height": 230
      },
      "output": "src/content/docs/de/company-gpt/prompts.png"
    },
    {
      "id": "prompt-variablen",
      "lang": "de",
      "note": "Bearbeitungsseite des eigenen Demo-Prompts mit Text, Variablen, Beschreibung und Befehl (nur geöffnet, nichts gespeichert).",
      "baseUrl": "demo",
      "path": "/c/new",
      "waitFor": "role=button[name=\"Attach and tools\"]",
