---
import config from 'virtual:starlight/user-config';

const links = config.social || [];
---

<a
	class="header-button"
	href="https://innfactory.ai"
	target="_blank"
	rel="noopener noreferrer"
>
	innFactory AI
</a>

<a
	class="header-button"
	href="https://support.innfactory.ai"
	target="_blank"
	rel="noopener noreferrer"
>
	Support
</a>

<style>
	@layer starlight.core {
		/* The SDK Button recipe `header-action` (PageHeader actions), with a `border-medium` edge: its
		   `border-light` one is invisible on the dark header. */
		.header-button {
			display: inline-flex;
			align-items: center;
			height: 2rem;
			padding: 0 0.75rem;
			border-radius: var(--theme-radius-xl);
			border: 1px solid rgb(var(--border-medium));
			background: rgb(var(--presentation));
			color: rgb(var(--text-primary));
			font-size: var(--sl-text-sm);
			font-weight: 500;
			line-height: 1;
			text-decoration: none;
			white-space: nowrap;
		}

		.header-button:hover {
			background: rgb(var(--surface-active-alt));
		}
	}
</style>
