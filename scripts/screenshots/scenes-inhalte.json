{
  "baseUrls": {
    "demo": "https://companygpt.innfactory.ai"
  },
  "defaults": {
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "deviceScaleFactor": 1,
    "colorScheme": "light",
    "public": false
