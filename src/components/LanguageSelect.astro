---
/**
 * starlight-openapi injects its generated reference under a single, locale-less
 * route tree (`/api/companyrag/...`). Starlight's language select builds its
 * options by prefixing the current path with each locale, which for those pages
 * yields URLs that do not exist (`/de/api/companyrag/`, `/en/api/companyrag/`).
 *
 * The generated reference only exists in one language, so we hide the select
 * there instead of offering broken links. The German and English intro pages
 * (`/de|en/api/company-rag-api/`) keep the normal switcher.
 */
import Default from '@astrojs/starlight/components/LanguageSelect.astro';

const isGeneratedApiReference = Astro.url.pathname.startsWith('/api/companyrag');
---

{!isGeneratedApiReference && <Default><slot /></Default>}
