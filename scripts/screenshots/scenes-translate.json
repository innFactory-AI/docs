      "selector": "main .bg-surface-card",
      "padding": 16,
      "output": "src/content/docs/en/company-gpt/addons/company-translate/text-uebersetzung.png"
    },
    {
      "id": "translate-text-glossar",
      "lang": "de",
      "baseUrl": "demo",
      "path": "/companygpt/translate/de/text",
      "note": "Globales Glossar „firmenbegriffe“ gestellt (Testkonto ist kein Admin); muster-glossar existiert im Demo-Tenant und wird real angewendet.",
      "routes": [
        {
          "urlPattern": "/\\/api\\/translate\\/glossary\\?from=de&to=en/",
          "fixture": "translate-glossare-de-en.json"
        }
      ],
      "waitFor": "main button:has-text(\"Sprache erkennen\")",
      "actions": [
        {
          "action": "click",
          "selector": "main button:has-text(\"Deutsch\")"
        },
        {
          "action": "fill",
          "selector": "main textarea",
          "value": "Die Besprechung mit dem Vorstand beginnt um 10 Uhr."
        },
        {
          "action": "wait",
          "selector": "main >> text=Glossar angewendet"
        },
        {
          "action": "click",
          "selector": "main button[aria-haspopup=dialog]:has-text(\"muster-glossar\")"
        },
        {
          "action": "wait",
          "selector": "[role=dialog] [role=option]:has-text(\"firmenbegriffe\")"
        }
      ],
      "settleMs": 800,
      "clip": {
        "x": 272,
        "y": 120,
        "width": 1136,
        "height": 585
      },
      "output": "src/content/docs/de/company-gpt/addons/company-translate/text-glossar.png"
    },
