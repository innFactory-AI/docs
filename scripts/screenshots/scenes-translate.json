    {
      "id": "translate-dokument-download",
      "lang": "de",
      "baseUrl": "demo",
      "path": "/companygpt/translate/de/file",
      "note": "Braucht die Aktion \"upload\" (setInputFiles aus fixtures/), die capture.mjs noch nicht kennt. Upload, Status und Download sind gestellt, damit kein neuer Auftrag im Tenant entsteht.",
      "routes": [
        {
          "urlPattern": "**/api/translate/history",
          "fixture": "translate-verlauf.json"
        },
        {
          "urlPattern": "/\\/api\\/translate\\/glossary\\?from=de&to=en/",
          "fixture": "translate-glossare-de-en.json"
        },
        {
          "urlPattern": "**/api/translate/file",
          "method": "POST",
          "status": 202,
          "json": {
            "jobId": "tr-muster-1",
            "statusUrl": "/api/translate/status?id=tr-muster-1",
            "targetBlobPath": "files/muster/tr-muster-1/result.docx"
          }
        },
        {
          "urlPattern": "**/api/translate/status?*",
          "json": {
            "status": "Succeeded",
            "blobPath": "files/muster/tr-muster-1/result.docx"
          }
        },
        {
          "urlPattern": "**/api/translate/download?*",
          "json": {
            "url": "https://example.com/muster-anschreiben_en.docx",
            "expiresAt": "2026-10-17T08:00:00.000Z"
          }
        }
      ],
      "waitFor": "main >> text=Datei zum Übersetzen ablegen",
      "actions": [
        {
          "action": "upload",
          "selector": "main input[type=file]",
          "file": "translate/muster-anschreiben.docx"
        },
        {
          "action": "click",
          "selector": "main button:has-text(\"Deutsch\")"
        },
        {
          "action": "wait",
          "selector": "main >> text=Glossar auswählen"
        },
        {
          "action": "click",
          "selector": "main button:text-is(\"Übersetzen\")"
        },
        {
          "action": "wait",
          "selector": "main >> text=Übersetzung abgeschlossen"
        }
      ],
      "settleMs": 1000,
      "selector": "main .bg-surface-card",
      "padding": 16,
      "output": "src/content/docs/de/company-gpt/addons/company-translate/dokument-download.png"
    },
